	"components": {
		"schemas": {
			"CreateTemplate": {
				"type": "object",
				"properties": {
					"templateText": {
						"type": "string",
						"maxLength": 200,
						"minLength": 0
					}
				},
				"required": [
					"templateText"
				]
			},
			"CreateNotification": {
				"type": "object",
				"properties": {
					"phoneNumber": {
						"type": "string",
						"maxLength": 20,
						"minLength": 0,
						"pattern": "^\\d{3}[- .]?\\d{3}[- .]?\\d{4}$"
					},
					"personalization": {
						"type": "string",
						"maxLength": 25,
						"minLength": 0
					},
					"templateId": {
						"type": "string",
						"pattern": "[0-9]*"
					},
					"templateText": {
						"type": "string",
						"maxLength": 200,
						"minLength": 0
					}
				},
				"required": [
					"phoneNumber"
				]
			},
			"UpdateTemplate": {
				"type": "object",
				"properties": {
					"templateId": {
						"type": "string",
						"minLength": 1,
						"pattern": "[0-9]+"
					},
					"newTemplateText": {
						"type": "string",
						"maxLength": 200,
						"minLength": 0
					}
				},
				"required": [
					"newTemplateText",
					"templateId"
				]
			}
		}
	}
}